{% extends 'front/base.html.twig' %}

{% block title %}Hello FrontController!{% endblock %}

{% block header %}
    {% include 'include/header.html.twig' %}
{% endblock %}

 {% block container %}
     <section class="banner-two">
         <div class="container">
             <div class="row">
                 <div class="col-xl-6">
                     <div class="banner-two__left wow fadeInLeft animated" data-wow-delay="100ms" style="visibility: visible; animation-delay: 100ms; animation-name: fadeInLeft;">
                         <div class="banner-two__title-box">
                             <p class="banner-two__sub-title">Questions dy jour</p>
                             <h2 class="banner-two__title"> Quand dois-je me mettre à faire mon déménagement?</h2>
                         </div>
                         <p class="banner-two__text">Le plus tôt sera le mieux pour déménager dans des conditions optimales. Parce que faire un bon déménagement nécessite du temps, de l'investissement et de l'argent, l'organisation sera votre meilleur ami pour mener à bien votre projet de déménagement.
                         </p>
                         <div class="banner-two__btn-and-video-box">
                             <div class="banner-two__btn-box">
                                 <a href="about.html" class="banner-two__btn thm-btn">Read more
                                     <span><i class="fa-solid fa-angles-right fa-lg"></i></span></a>
                             </div>
                             <div class="banner-two__video-link">
                                 <a href="https://www.youtube.com/watch?v=Get7rqXYrbQ" class="video-popup">
                                     <div class="banner-two__video-icon">
                                         <span class="fas fa-play"></span>
                                         <i class="ripple"></i>
                                     </div>
                                 </a>
                                 <h4 class="banner-two__video-text">See How It Works</h4>
                             </div>
                         </div>
                         <div class="banner-two__trusted-clients">
                             <ul class="list-unstyled banner-two__trusted-clients-list">
                                 <li>
                                     <div class="banner-two__trusted-clients-img">
                                         <img src="assets/images/resources/banner-two-trusted-clients-1-1.jpg" alt="">
                                     </div>
                                 </li>
                                 <li>
                                     <div class="banner-two__trusted-clients-img">
                                         <img src="assets/images/resources/banner-two-trusted-clients-1-2.jpg" alt="">
                                     </div>
                                 </li>
                                 <li>
                                     <div class="banner-two__trusted-clients-img">
                                         <img src="assets/images/resources/banner-two-trusted-clients-1-3.jpg" alt="">
                                     </div>
                                 </li>
                             </ul>
                             <div class="banner-two__trusted-clients-content">
                                 <div class="banner-two__trusted-clients-count">
                                     <div class="banner-two__count count-box counted">
                                         <h3 class="count-text" data-stop="4000" data-speed="1500">4000</h3>
                                         <span>+</span>
                                     </div>
                                     <p class="banner-two__trusted-clients-text">Trusted Clients</p>
                                 </div>
                             </div>
                         </div>
                     </div>
                 </div>
                 <div class="col-xl-6">
                     <div class="banner-two__right wow fadeInRight animated" data-wow-delay="300ms" style="visibility: visible; animation-delay: 300ms; animation-name: fadeInRight;">
                         <div class="banner-two__shape-1"></div>
                         <div class="banner-two__shape-2"></div>
                         <ul class="list-unstyled banner-two__img-list">
                             <li>
                                 <div class="banner-two__img-single">
                                     <img src="{{ asset("images/resources/banner-two-img-1-1.jpg") }}" alt="">
                                 </div>
                             </li>
                             <li>
                                 <div class="banner-two__img-single">
                                     <img src="{{ asset("images/resources/banner-two-img-1-2.jpg") }}" alt="">
                                 </div>
                             </li>
                             <li>
                                 <div class="banner-two__img-single">
                                     <img src="{{ asset("images/resources/banner-two-img-1-3.jpg") }}" alt="">
                                 </div>
                             </li>
                         </ul>
                     </div>
                 </div>
             </div>
         </div>
     </section>
 {% endblock %}
